NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/stay-wise?retryWrites=true&w=majority

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRE=90d
FIELD_ENCRYPTION_KEY=replace_with_32_byte_base64_key

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

COMPANY_NAME=Stay Wise Miami
COMPANY_EMAIL=info@staywise.miami
COMPANY_PHONE=(305) 615-3735
COMPANY_PHONE_E164=+13056153735
COMPANY_ADDRESS=1717 N Bayshore Dr. Ste R217, Miami, FL
COMPANY_URL=https://www.staywise.miami

BREVO_API_KEY=replace_me_if_using_brevo_api
BREVO_SENDER_EMAIL=info@staywise.miami
BREVO_SENDER_NAME=Stay Wise Miami
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Copy these from Brevo Settings > SMTP & API > SMTP.
# SMTP_USER is the Brevo SMTP login. SMTP_PASS is the SMTP key, not the API key.
SMTP_USER=replace_with_brevo_smtp_login
SMTP_PASS=replace_with_brevo_smtp_key
ADMIN_EMAIL=info@staywise.miami

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.5-flash

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_CHAT_ID=replace_me
ADMIN_DEEP_LINK_SECRET=replace_with_long_random_secret

FRONTEND_URL=https://www.staywise.miami
ADMIN_URL=https://admin.staywise.miami

# Optional. Only set this if you actually provision Redis.
# REDIS_URL=rediss://default:PASSWORD@redis-host:6379
# REDIS_PASSWORD=replace_me
