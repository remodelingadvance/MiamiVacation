    "framer-motion": "^10.16.16",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-awesome-reveal": "^4.2.4",
    "react-calendar": "^6.0.1",
    "react-countup": "^6.5.0",
